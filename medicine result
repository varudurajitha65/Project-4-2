<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Medicine Assistance Result</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f4f7f6; padding: 40px; }
        .container { max-width: 650px; background: white; padding: 30px; border-radius: 10px; margin: auto; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        h2 { color: #1b5e20; border-bottom: 2px solid #e8f5e9; padding-bottom: 10px; }
        .box { background: #e8f5e9; border-left: 5px solid #2e7d32; padding: 18px; margin: 20px 0; border-radius: 6px; }
        .warning { background: #fff3cd; border-left: 5px solid #ffc107; padding: 18px; margin: 20px 0; border-radius: 6px; }
        .btn { display: inline-block; background: #2e7d32; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; margin-top: 15px; }
        .note { font-size: 12px; color: #666; margin-top: 25px; border-top: 1px solid #ddd; padding-top: 10px; }
    </style>
</head>
<body>
<div class="container">
    <h2>Affordable Medicine Alternatives</h2>
    {% if med %}
        <div class="box">
            <p><strong>Search Term:</strong> {{ query.title() }}</p>
            <p><strong>Branded Option:</strong> {{ med.brand_name }} (Price: {{ med.brand_price }})</p>
            <p><strong>Affordable Generic Alternative:</strong> <span style="color:#2e7d32; font-weight:bold;">{{ med.generic_name }}</span></p>
            <p><strong>Generic Cost:</strong> {{ med.generic_price }}</p>
            <p><strong>Dosage Info:</strong> {{ med.dosage }}</p>
        </div>
    {% else %}
        <div class="warning">
            <p>No exact generic match found for "<strong>{{ query }}</strong>" in local database. Please consult a registered doctor or pharmacist.</p>
        </div>
    {% endif %}
    
    <a href="/" class="btn">&larr; Back to Dashboard</a>

    <!-- English Note at the bottom -->
    <div class="note">
        <strong>Note:</strong> This system provides generic medicine suggestions for informational purposes only. Please consult a qualified medical practitioner before switching medications.
    </div>
</div>
</body>
</html>
