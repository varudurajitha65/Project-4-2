DEFAULT_USERS = {
    "admin": "admin123",
    "user": "user123"
}
USERS_FILE = os.path.join(app.instance_path, 'users.json')

def save_users(users):
    os.makedirs(app.instance_path, exist_ok=True)
    temporary_file = f'{USERS_FILE}.tmp'
    with open(temporary_file, 'w', encoding='utf-8') as user_file:
        json.dump(users, user_file)
    os.replace(temporary_file, USERS_FILE)

def load_users():
    try:
        with open(USERS_FILE, encoding='utf-8') as user_file:
            saved_users = json.load(user_file)
    except FileNotFoundError:
        saved_users = {}

    if not isinstance(saved_users, dict):
        raise ValueError('Stored user data must be a JSON object.')

    users = {}
    for username, password in saved_users.items():
        if not isinstance(username, str) or not isinstance(password, str):
            continue
        if password.startswith(('scrypt:', 'pbkdf2:')):
            users[username] = password
        else:
            users[username] = generate_password_hash(password)

    for username, password in DEFAULT_USERS.items():
        users.setdefault(username, generate_password_hash(password))

    save_users(users)
    return users

USERS = load_users()

