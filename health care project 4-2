@app.route('/api/login', methods=['POST'])
def api_login():
    data = request.get_json(silent=True) or {}
    username = data.get('username', '').strip() if isinstance(data.get('username'), str) else ''
    password = data.get('password')
    stored_password = USERS.get(username)
    if stored_password and isinstance(password, str) and check_password_hash(stored_password, password):
        session['username'] = username
        session.permanent = data.get('remember_me') is True
        return {"status": "success", "username": username}
    return {"status": "error", "message": "Invalid username or password"}, 401

@app.route('/api/register', methods=['POST'])
def api_register():
    data = request.get_json(silent=True) or {}
    username = data.get('username', '').strip() if isinstance(data.get('username'), str) else ''
    password = data.get('password')

    if not re.fullmatch(r'[A-Za-z0-9_.-]{3,30}', username):
        return {"status": "error", "message": "Username must be 3-30 characters using letters, numbers, dots, underscores, or hyphens."}, 400
    if not isinstance(password, str) or len(password) < 6:
        return {"status": "error", "message": "Password must be at least 6 characters."}, 400
    if username in USERS:
        return {"status": "error", "message": "That username is already taken."}, 409

    USERS[username] = generate_password_hash(password)
    try:
        save_users(USERS)
    except OSError:
        USERS.pop(username, None)
        return {"status": "error", "message": "Could not save your account. Please try again."}, 500
    session['username'] = username
    return {"status": "success", "username": username}, 201

@app.route('/api/logout')
def api_logout():
    session.pop('username', None)
    session.permanent = False
    return {"status": "success"}

@app.route('/api/medicines', methods=['GET'])
def get_medicines():
    letter = request.args.get('letter', '').upper()
    query = request.args.get('q', '').strip().casefold()
    
    filtered = MEDICINE_DB
    if letter:
        filtered = [m for m in filtered if m['generic_name'].upper().startswith(letter) or m['brand_name'].upper().startswith(letter)]
    if query:
        filtered = [
            m for m in filtered
            if any(query in value.casefold() for value in (m['generic_name'], m['brand_name'], *m.get('search_terms', [])))
        ]
        
    return {"status": "success", "data": filtered}

@app.route('/api/diet', methods=['GET'])
def get_diet():
    query = request.args.get('q', '').strip().lower()
    matched_key = next((k for k in DIET_DB if k in query), None)
    
    diet_data = DIET_DB.get(matched_key, {
        "category": f"Custom Guidelines for: {query.title() if query else 'General Health'}",
        "foods_to_eat": "Balanced portions of fresh fruits, vegetables, clean proteins, and whole grains.",
        "foods_to_avoid": "Ultra-processed foods, artificial sweeteners, excessive oils, and refined sugars.",
        "tip": "Ensure adequate daily water intake and consult a specialist for structured guidance."
    })
    return {"status": "success", "data": diet_data}

@app.route('/api/scan_prescription', methods=['POST'])
def scan_prescription():
    prescription = request.files.get('prescription')
    if prescription is None or not prescription.filename:
        return {"status": "error", "message": "Please upload a prescription image."}, 400
    if not prescription.mimetype.startswith('image/'):
        return {"status": "error", "message": "Please upload a valid image file."}, 400

    # Simulated OCR extraction
    scanned_meds = [m for m in MEDICINE_DB if m['generic_name'].startswith('Paracetamol') or m['generic_name'].startswith('Omeprazole')]
    return {
        "status": "success",
        "extracted_text": "Rx: Paracetamol 500mg, Omeprazole 20mg - 1 tablet daily before breakfast",
        "scanned_meds": scanned_meds
    }

